{
  "name": "bursary-bridge",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/copy-pdf-worker.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/copy-pdf-worker.mjs",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:demo": "tsx prisma/seed-demo.ts",
    "purge:mock": "tsx scripts/purge-mock-data.ts",
    "audit:production": "tsx scripts/production-audit.ts",
    "db:reset": "prisma migrate reset --force",
    "db:studio": "prisma studio",
    "test:matching": "tsx scripts/test-matching.ts",
    "test:e2e": "tsx scripts/e2e.ts",
    "test:pdf": "tsx scripts/test-pdf-autofill.ts",
    "test:pdf:labels": "tsx scripts/test-matching-labels.ts",
    "test:autofill": "tsx --conditions=react-server scripts/test-auto-fill-service.ts",
    "test:catalogue": "tsx scripts/test-catalogue.ts && tsx --conditions=react-server scripts/test-catalogue-service.ts",
    "test:results": "tsx --conditions=react-server scripts/test-results-service.ts",
    "test:requests": "tsx --conditions=react-server scripts/test-information-requests.ts",
    "test:letters": "tsx scripts/test-letters.ts && tsx --conditions=react-server scripts/test-letters-service.ts",
    "test:letters:ui": "tsx --conditions=react-server scripts/test-letters-ui.ts",
    "test:ingest": "tsx --conditions=react-server scripts/test-ingest.ts",
    "test:directory": "tsx --conditions=react-server scripts/test-directory-e2e.ts",
    "test": "npm run test:matching && npm run test:pdf:labels && npm run test:pdf && npm run test:autofill && npm run test:catalogue && npm run test:results && npm run test:requests && npm run test:letters && npm run test:ingest && npm run test:directory && npm run test:letters:ui && npm run test:e2e",
    "screenshots": "tsx scripts/screenshots.ts",
    "ingest": "tsx --conditions=react-server scripts/ingest.ts",
    "make:test-forms": "tsx scripts/make-test-forms.ts",
    "import:pages": "tsx --conditions=react-server scripts/import-pages.ts",
    "verify:opportunities": "tsx --conditions=react-server scripts/verify-opportunities.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^2.4.3",
    "cheerio": "^1.2.0",
    "clsx": "^2.1.1",
    "jszip": "^3.10.1",
    "next": "15.5.4",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^2.5.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "playwright": "^1.62.1",
    "postcss": "^8.4.49",
    "prettier": "3.4.2",
    "prettier-plugin-tailwindcss": "0.6.9",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
