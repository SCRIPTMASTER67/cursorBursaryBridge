# ---------------------------------------------------------------------------
# Bursary-Bridge — environment configuration
# Copy to `.env` and adjust. NEVER commit a real .env file.
# ---------------------------------------------------------------------------

# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://bursary:bursary@localhost:5432/bursarybridge?schema=public"

# Secret used to derive session identifiers. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="replace-me-with-a-32-byte-random-hex-string"

# Public base URL of the app (used in verification links / emails).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# File storage
# `local`  -> files are written to LOCAL_STORAGE_DIR (development only)
# `s3`     -> S3-compatible object storage (production)
# ---------------------------------------------------------------------------
STORAGE_DRIVER="local"
LOCAL_STORAGE_DIR=".uploads"

# Only required when STORAGE_DRIVER="s3"
S3_ENDPOINT=""
S3_REGION="af-south-1"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# ---------------------------------------------------------------------------
# Email
# `console` -> notification emails are logged to the server console (default)
# `smtp`    -> a development SMTP server such as Mailpit / Mailhog
# ---------------------------------------------------------------------------
EMAIL_DRIVER="console"
EMAIL_FROM="Bursary-Bridge <no-reply@bursarybridge.local>"
SMTP_HOST=""
SMTP_PORT="1025"

# Seeded demo account password. Used ONLY by `npm run db:seed`.
DEMO_PASSWORD="Demo1234!"
