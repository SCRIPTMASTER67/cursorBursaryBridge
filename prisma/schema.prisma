// ---------------------------------------------------------------------------
// Bursary-Bridge — PostgreSQL schema
//
// Two visible roles: STUDENT and CORPORATE.
// Service boundaries are kept clean so that verification, messaging and
// reporting subsystems can be layered on later without a rewrite.
// ---------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===========================================================================
// Enums
// ===========================================================================

enum UserRole {
  STUDENT
  CORPORATE
  ADMIN
}

/// Account state. Suspension is reversible and is the only account-level
/// control an administrator has; accounts are never deleted from the portal.
enum AccountStatus {
  ACTIVE
  SUSPENDED
}

enum EducationStage {
  GRADE_10
  GRADE_11
  MATRIC
  UNIVERSITY_FIRST_YEAR
  UNIVERSITY_CURRENT
  TVET_COLLEGE
  POSTGRADUATE
  PLANNING_TO_STUDY
  OTHER
}

enum QualificationLevel {
  CERTIFICATE
  DIPLOMA
  ADVANCED_DIPLOMA
  BACHELORS
  HONOURS
  MASTERS
  DOCTORAL
  OTHER
}

enum StudyStatus {
  CURRENTLY_ENROLLED
  ACCEPTED_NOT_REGISTERED
  APPLIED_AWAITING
  PLANNING_TO_APPLY
  RETURNING_STUDENT
  OTHER
}

enum ResultType {
  SCHOOL_REPORT
  MATRIC_RESULTS
  UNIVERSITY_TRANSCRIPT
  ACADEMIC_RECORD
  OTHER
  NONE_YET
}

enum Achievement {
  SUBJECT_DISTINCTIONS
  ACADEMIC_AWARDS
  DEANS_LIST
  COMPETITIONS
  OLYMPIADS
  RESEARCH
  OTHER
  NONE
}

enum FundingNeed {
  TUITION_FEES
  REGISTRATION_FEES
  ACCOMMODATION
  BOOKS_MATERIALS
  MEALS_LIVING
  TRANSPORT
  LAPTOP_DEVICE
  OTHER_EXPENSES
  FULL_FUNDING
  PARTIAL_FUNDING
  NOT_SURE
}

enum FundingSituation {
  NO_FUNDING
  PARTIALLY_FUNDED
  FULLY_FUNDED
  AWAITING_DECISION
  DONT_KNOW
}

enum BursaryStatus {
  YES
  NO
  APPLICATION_PENDING
  PREFER_NOT_TO_SAY
}

enum IncomeBand {
  BELOW_50K
  R50K_100K
  R100K_200K
  R200K_350K
  R350K_500K
  ABOVE_500K
  DONT_KNOW
  PREFER_NOT_TO_SAY
}

enum Citizenship {
  SA_CITIZEN
  PERMANENT_RESIDENT
  OTHER
  PREFER_NOT_TO_SAY
}

enum TriState {
  YES
  NO
  PREFER_NOT_TO_SAY
}

enum StudyLocationPreference {
  SAME_LOCATION
  DIFFERENT_LOCATION
  NOT_SURE
}

enum CareerInterest {
  TECHNOLOGY
  ENGINEERING
  HEALTHCARE
  FINANCE_ACCOUNTING
  LAW
  EDUCATION
  AGRICULTURE
  SCIENCE_RESEARCH
  BUSINESS
  GOVERNMENT
  MINING
  ENERGY
  MANUFACTURING
  CONSTRUCTION
  MEDIA_COMMUNICATIONS
  OTHER
}

enum Province {
  EASTERN_CAPE
  FREE_STATE
  GAUTENG
  KWAZULU_NATAL
  LIMPOPO
  MPUMALANGA
  NORTHERN_CAPE
  NORTH_WEST
  WESTERN_CAPE
}

enum InstitutionType {
  UNIVERSITY
  UNIVERSITY_OF_TECHNOLOGY
  TVET_COLLEGE
  PRIVATE_INSTITUTION
  OTHER
}

enum OrganisationType {
  CORPORATION
  FOUNDATION
  NGO
  NON_PROFIT
  PROFESSIONAL_ORGANISATION
  GOVERNMENT_ORGANISATION
  EDUCATIONAL_ORGANISATION
  OTHER
}

enum Industry {
  FINANCIAL_SERVICES
  MINING
  TECHNOLOGY
  TELECOMMUNICATIONS
  ENGINEERING
  HEALTHCARE
  ENERGY
  MANUFACTURING
  RETAIL
  CONSTRUCTION
  PROFESSIONAL_SERVICES
  OTHER
}

enum CorporateRole {
  BURSARY_FUNDING_MANAGER
  HR_MANAGER
  TALENT_MANAGER
  CSI_MANAGER
  FOUNDATION_MANAGER
  PROGRAMME_MANAGER
  ADMINISTRATOR
  EXECUTIVE
  OTHER
}

enum OrganisationSize {
  UNDER_50
  SIZE_50_250
  SIZE_251_1000
  SIZE_1001_5000
  ABOVE_5000
}

enum ProgrammeTypeOffered {
  BURSARIES
  SCHOLARSHIPS
  GRANTS
  INTERNSHIPS
  LEARNERSHIPS
  GRADUATE_PROGRAMMES
  OTHER
}

enum OffersFunding {
  YES
  NO
  PLANNING_TO
  NOT_SURE
}

enum ApplicationVolume {
  UNDER_100
  V100_500
  V501_1000
  V1001_5000
  V5001_10000
  ABOVE_10000
}

enum ProcessMethod {
  EMAIL
  SPREADSHEETS
  GOOGLE_FORMS
  WEBSITE_FORMS
  DEDICATED_SOFTWARE
  MANUAL_PROCESS
  OTHER
}

enum ProcessChallenge {
  TOO_MANY_APPLICATIONS
  MANUAL_SCREENING
  DOCUMENT_VERIFICATION
  FINDING_ELIGIBLE_APPLICANTS
  COMMUNICATION
  SHORTLISTING
  REPORTING
  FRAUD_DUPLICATES
  TRACKING_BENEFICIARIES
  OTHER
}

enum FundingType {
  BURSARY
  SCHOLARSHIP
  GRANT
  OTHER
}

enum FundingCoverage {
  TUITION_FEES
  REGISTRATION_FEES
  ACCOMMODATION
  MEALS_LIVING
  BOOKS_MATERIALS
  LAPTOP_DEVICE
  TRANSPORT
  OTHER
}

enum ProgrammeStatus {
  DRAFT
  PUBLISHED
  CLOSED
  /// Withdrawn by an administrator for a policy breach. Only an administrator
  /// can clear it, so the owning organisation cannot simply publish again.
  SUSPENDED
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  DOCUMENTS_REQUIRED
  SHORTLISTED
  APPROVED
  UNSUCCESSFUL
}

enum MatchClassification {
  STRONG_MATCH
  POTENTIAL_MATCH
  MORE_INFO_NEEDED
}

/// The funder-facing verdict, recorded when an application is submitted.
/// Missing information is PENDING_VERIFICATION, never an automatic rejection.
enum EligibilityOutcome {
  ELIGIBLE
  NOT_ELIGIBLE
  PENDING_VERIFICATION
}

enum DocumentType {
  ID_DOCUMENT
  ACADEMIC_RECORD
  TRANSCRIPT
  MATRIC_CERTIFICATE
  PROOF_OF_RESIDENCE
  PROOF_OF_INCOME
  PROOF_OF_REGISTRATION
  CV
  MOTIVATION_LETTER
  OTHER
}

enum ShortlistStatus {
  SHORTLISTED
  SELECTED
  WITHDRAWN
}

enum NotificationType {
  NEW_MATCH
  APPLICATION_SUBMITTED
  APPLICATION_STATUS_CHANGED
  DEADLINE_APPROACHING
  INFORMATION_REQUESTED
  PROGRAMME_PUBLISHED
  WELCOME
}

enum QuestionType {
  SHORT_TEXT
  LONG_TEXT
  SINGLE_SELECT
  MULTI_SELECT
  NUMBER
  DATE
  YES_NO
}

// ===========================================================================
// Identity & access
// ===========================================================================

model User {
  id                 String        @id @default(cuid())
  email              String        @unique
  passwordHash       String
  role               UserRole
  status             AccountStatus @default(ACTIVE)
  mustResetPassword  Boolean       @default(false)
  firstName          String
  lastName           String
  mobile             String?
  emailVerifiedAt    DateTime?
  emailNotifications Boolean       @default(true)
  acceptedTermsAt    DateTime?
  lastLoginAt        DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  sessions            Session[]
  verificationToken   VerificationToken?
  passwordResetToken  PasswordResetToken?
  studentProfile      StudentProfile?
  corporateProfile    CorporateProfile?
  notifications       Notification[]
  informationRequests InformationRequest[] @relation("InformationRequester")
  auditLogs           AuditLog[]
  createdProgrammes   FundingProgramme[]   @relation("ProgrammeCreator")
  shortlistEntries    Shortlist[]          @relation("ShortlistAddedBy")

  @@index([role])
  @@index([status])
}

/// Opaque, revocable server-side sessions. Only the SHA-256 hash of the
/// session token is stored, so a database leak cannot be replayed as a login.
model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  userAgent String?
  ipAddress String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// Single-use password reset tokens.
///
/// Separate from VerificationToken because that model is unique on userId and
/// already carries email verification; one table could not hold both for the
/// same account. Only the hash is stored, so the database cannot be read to
/// forge a reset link. Unique on userId, so issuing a new link invalidates any
/// previous one.
model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String   @unique
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  id        String   @id @default(cuid())
  userId    String   @unique
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ===========================================================================
// Reference catalogue (standardised institutions & programmes)
// ===========================================================================

model Institution {
  id        String          @id @default(cuid())
  name      String          @unique
  shortName String?
  type      InstitutionType
  province  Province
  city      String
  website   String?
  /// The institution's own code, where it has one (e.g. a DHET number).
  code      String?

  /// Institutions are retired, never deleted: a student's chosen institution
  /// and a funder's eligibility rules both point at these rows, and removing
  /// one would rewrite history. An inactive institution stops being offered
  /// to new choices while every existing reference keeps working.
  status CatalogueStatus @default(ACTIVE)

  /// Lower-case, punctuation-free form of the name. Unique, so "University of
  /// Johannesburg" and "university of johannesburg " cannot both exist.
  canonicalName String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  studyPreferences   StudyPreference[]
  currentStudents    StudentProfile[]              @relation("CurrentInstitution")
  supportedInProgram FundingProgrammeInstitution[]
  offeredProgrammes  ProgrammeInstitution[]

  @@index([province])
  @@index([type])
  @@index([status])
}

/// A standardised course / programme of study (e.g. "Computer Science").
model Programme {
  id                  String               @id @default(cuid())
  name                String               @unique
  field               CareerInterest
  qualificationLevels QualificationLevel[]
  /// The institution's or SAQA's code for the qualification, where known.
  code                String?

  status CatalogueStatus @default(ACTIVE)

  /// Lower-case, punctuation-free form of the name; unique, to stop the same
  /// course arriving twice under two spellings.
  canonicalName String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  studyPreferences   StudyPreference[]
  currentStudents    StudentProfile[]            @relation("CurrentProgramme")
  supportedInProgram FundingProgrammeProgramme[]
  offeredAt          ProgrammeInstitution[]

  @@index([field])
  @@index([status])
}

// ===========================================================================
// Student
// ===========================================================================

model StudentProfile {
  id     String @id @default(cuid())
  userId String @unique

  // Education journey
  educationStage       EducationStage?
  qualificationLevel   QualificationLevel?
  studyStatus          StudyStatus?
  currentInstitutionId String?
  currentProgrammeId   String?
  yearOfStudy          Int?

  // Academic profile
  academicAverage        Int?
  academicAverageUnknown Boolean       @default(false)
  resultTypes            ResultType[]
  achievements           Achievement[]

  // Funding needs
  fundingNeeds     FundingNeed[]
  fundingSituation FundingSituation?
  bursaryStatus    BursaryStatus?

  // Financial profile
  householdIncome IncomeBand?

  // Personal eligibility
  dateOfBirth      DateTime?
  citizenship      Citizenship?
  firstGeneration  TriState?
  disability       TriState?
  orphanVulnerable TriState?

  // Location
  province                Province?
  city                    String?
  studyLocationPreference StudyLocationPreference?

  // Interests
  careerInterests CareerInterest[]

  // Onboarding / progressive completion
  onboardingStep        String    @default("education")
  onboardingCompletedAt DateTime?
  profileStrength       Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user                User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentInstitution  Institution?           @relation("CurrentInstitution", fields: [currentInstitutionId], references: [id], onDelete: SetNull)
  currentProgramme    Programme?             @relation("CurrentProgramme", fields: [currentProgrammeId], references: [id], onDelete: SetNull)
  studyPreferences    StudyPreference[]
  applications        Application[]
  documents           Document[]
  autoFillJobs        AutoFillJob[]
  subjectResults      StudentSubjectResult[]
  motivationalLetters MotivationalLetter[]

  @@index([province])
  @@index([educationStage])
}

/// A course paired with the institution the student wants to study it at.
/// A student may hold a maximum of six (enforced in the service layer and by
/// the unique constraint on preferenceNumber).
model StudyPreference {
  id               String @id @default(cuid())
  studentProfileId String
  preferenceNumber Int
  programmeId      String
  institutionId    String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  programme      Programme      @relation(fields: [programmeId], references: [id], onDelete: Restrict)
  institution    Institution    @relation(fields: [institutionId], references: [id], onDelete: Restrict)

  @@unique([studentProfileId, preferenceNumber])
  @@unique([studentProfileId, programmeId, institutionId])
  @@index([programmeId])
  @@index([institutionId])
}

// ===========================================================================
// Corporate / funder
// ===========================================================================

model Organisation {
  id          String           @id @default(cuid())
  name        String           @unique
  status      AccountStatus    @default(ACTIVE)
  type        OrganisationType
  industry    Industry
  website     String?
  country     String           @default("South Africa")
  description String?
  logoUrl     String?

  /// REGISTERED means somebody from this organisation signed up and published
  /// here. EXTERNAL means the organisation was recorded because a public
  /// source named it as a funder; it has no account and has not been contacted.
  origin    OrganisationOrigin @default(REGISTERED)
  /// The page that named this organisation as a funder, for an EXTERNAL record.
  sourceUrl String?

  // Funding profile
  offersFunding     OffersFunding?
  programmeTypes    ProgrammeTypeOffered[]
  applicationVolume ApplicationVolume?

  // Current process
  processMethods ProcessMethod[]
  challenges     ProcessChallenge[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members             CorporateProfile[]
  programmes          FundingProgramme[]
  applications        Application[]
  shortlists          Shortlist[]
  informationRequests InformationRequest[]
}

model CorporateProfile {
  id               String            @id @default(cuid())
  userId           String            @unique
  organisationId   String
  role             CorporateRole?
  department       String?
  organisationSize OrganisationSize?

  onboardingStep        String    @default("organisation")
  onboardingCompletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@index([organisationId])
}

// ===========================================================================
// Funding programmes & eligibility
// ===========================================================================

model FundingProgramme {
  id               String            @id @default(cuid())
  organisationId   String
  createdById      String?
  name             String
  slug             String            @unique
  shortDescription String
  fullDescription  String
  fundingType      FundingType
  coverage         FundingCoverage[]

  /// Nullable because not every real opportunity has fixed dates. A bursary
  /// with rolling applications must not be given an invented deadline to
  /// satisfy a column.
  openDate     DateTime?
  closingDate  DateTime?
  deadlineKind DeadlineKind @default(FIXED)
  /// The deadline exactly as the source words it, when it is not a plain date
  /// ("Applications close at 23:59 on 15 October", "Until filled").
  deadlineNote String?

  status       ProgrammeStatus @default(DRAFT)
  intakeTarget Int?

  /// Where this opportunity came from. FIRST_PARTY means the funder published
  /// it here themselves; EXTERNAL means it was discovered on a public source
  /// and carries that source's provenance.
  origin OpportunityOrigin @default(FIRST_PARTY)

  /// Whether applications are actually open right now. Separate from `status`,
  /// which is the publication lifecycle: a PUBLISHED programme whose window
  /// has not opened is UPCOMING, not OPEN.
  availability Availability @default(UNKNOWN)

  /// Primary source, denormalised from `sources` for listing queries. Written
  /// only by recordSources() so the two cannot drift.
  sourceUrl      String?
  sourceName     String?
  sourceType     SourceType?
  officialSource Boolean     @default(false)

  verificationStatus VerificationStatus @default(UNVERIFIED)
  /// When the opportunity was last confirmed against its source.
  lastVerifiedAt     DateTime?
  /// When a check was last attempted, successful or not.
  lastCheckedAt      DateTime?

  /// Where the student actually applies, when the source states it.
  applicationUrl String?

  /// Stable identity for deduplication: the same programme listed on three
  /// sites must not become three opportunities.
  dedupeKey String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation("ProgrammeCreator", fields: [createdById], references: [id], onDelete: SetNull)

  eligibility           EligibilityRule?
  supportedInstitutions FundingProgrammeInstitution[]
  supportedProgrammes   FundingProgrammeProgramme[]
  questions             ApplicationQuestion[]
  applications          Application[]
  shortlists            Shortlist[]
  sources               OpportunitySource[]
  applicationForms      ApplicationForm[]
  conflicts             SourceConflict[]
  motivationalLetters   MotivationalLetter[]

  @@index([organisationId])
  @@index([status])
  @@index([closingDate])
  @@index([availability, closingDate])
  @@index([origin])
  @@index([verificationStatus])
}

/// The machine-readable rule set the eligibility & matching services evaluate.
model EligibilityRule {
  id                 String @id @default(cuid())
  fundingProgrammeId String @unique

  minAcademicAverage    Int?
  qualificationLevels   QualificationLevel[]
  yearsOfStudy          Int[]
  citizenship           Citizenship[]
  maxHouseholdIncome    IncomeBand?
  requiresFinancialNeed Boolean              @default(false)
  provinces             Province[]
  otherRequirements     String?
  requiredDocuments     DocumentType[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fundingProgramme    FundingProgramme                @relation(fields: [fundingProgrammeId], references: [id], onDelete: Cascade)
  subjectRequirements EligibilitySubjectRequirement[]
}

model FundingProgrammeInstitution {
  fundingProgrammeId String
  institutionId      String

  fundingProgramme FundingProgramme @relation(fields: [fundingProgrammeId], references: [id], onDelete: Cascade)
  institution      Institution      @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@id([fundingProgrammeId, institutionId])
  @@index([institutionId])
}

model FundingProgrammeProgramme {
  fundingProgrammeId String
  programmeId        String

  fundingProgramme FundingProgramme @relation(fields: [fundingProgrammeId], references: [id], onDelete: Cascade)
  programme        Programme        @relation(fields: [programmeId], references: [id], onDelete: Cascade)

  @@id([fundingProgrammeId, programmeId])
  @@index([programmeId])
}

/// Programme-specific questions asked at application time only — never during
/// student registration.
model ApplicationQuestion {
  id                 String       @id @default(cuid())
  fundingProgrammeId String
  label              String
  helpText           String?
  type               QuestionType
  required           Boolean      @default(false)
  options            String[]
  order              Int

  fundingProgramme FundingProgramme @relation(fields: [fundingProgrammeId], references: [id], onDelete: Cascade)

  @@index([fundingProgrammeId])
}

// ===========================================================================
// Applications
// ===========================================================================

model Application {
  id                 String            @id @default(cuid())
  studentProfileId   String
  fundingProgrammeId String
  organisationId     String
  status             ApplicationStatus @default(DRAFT)

  // Snapshot of the match at submission time, so the score shown to the funder
  // is stable even if the student later edits their profile.
  matchScore          Int?
  matchClassification MatchClassification?
  matchReasons        Json?
  eligibilityOutcome  EligibilityOutcome?

  answers            Json?
  reviewNotes        String?
  submittedAt        DateTime?
  lastStatusChangeAt DateTime?
  decisionAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  studentProfile      StudentProfile        @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  fundingProgramme    FundingProgramme      @relation(fields: [fundingProgrammeId], references: [id], onDelete: Cascade)
  organisation        Organisation          @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  documents           ApplicationDocument[]
  informationRequests InformationRequest[]
  shortlist           Shortlist?

  @@unique([studentProfileId, fundingProgrammeId])
  @@index([fundingProgrammeId, status])
  @@index([organisationId, status])
  @@index([studentProfileId])
  @@index([matchScore])
  @@index([organisationId, eligibilityOutcome])
}

model Document {
  id               String       @id @default(cuid())
  studentProfileId String
  type             DocumentType
  fileName         String
  mimeType         String
  sizeBytes        Int
  storageKey       String       @unique
  uploadedAt       DateTime     @default(now())

  studentProfile StudentProfile           @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  applications   ApplicationDocument[]
  requestItems   InformationRequestItem[]

  @@index([studentProfileId])
}

model ApplicationDocument {
  applicationId String
  documentId    String
  requirement   DocumentType

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  document    Document    @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@id([applicationId, documentId])
  @@index([documentId])
}

model Shortlist {
  id                 String          @id @default(cuid())
  organisationId     String
  fundingProgrammeId String
  applicationId      String          @unique
  addedById          String?
  status             ShortlistStatus @default(SHORTLISTED)
  note               String?
  addedAt            DateTime        @default(now())
  selectedAt         DateTime?

  organisation     Organisation     @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  fundingProgramme FundingProgramme @relation(fields: [fundingProgrammeId], references: [id], onDelete: Cascade)
  application      Application      @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  addedBy          User?            @relation("ShortlistAddedBy", fields: [addedById], references: [id], onDelete: SetNull)

  @@index([organisationId, status])
  @@index([fundingProgrammeId])
}

// ===========================================================================
// Notifications & audit
// ===========================================================================

model Notification {
  id          String           @id @default(cuid())
  userId      String
  type        NotificationType
  title       String
  body        String
  link        String?
  readAt      DateTime?
  emailSentAt DateTime?
  createdAt   DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([action, createdAt])
}

// ---------------------------------------------------------------------------
// Form auto-filling
//
// A student uploads one completed bursary form and any number of blank ones.
// The completed form is read into canonical values; each blank form is mapped
// against them field by field. Every decision is stored with the reason behind
// it, because the student is asked to check the result before submitting it
// and cannot check what they cannot see.
//
// Filled PDFs are not stored. They are produced from the original upload and
// the current field values whenever one is downloaded, so an edited value can
// never disagree with the file the student sends to a funder.
// ---------------------------------------------------------------------------

enum AutoFillJobStatus {
  DRAFT
  PROCESSING
  COMPLETED
  /// The completed form could not be read, so no target could be attempted.
  FAILED
}

enum AutoFillFormStatus {
  PENDING
  PROCESSING
  COMPLETED
  /// This form alone failed. The rest of the batch is unaffected.
  FAILED
}

/// The outcome of one field on one target form. Mirrors MappingStatus in
/// lib/pdf/map.ts; only FILLED and NEEDS_REVIEW carry a value.
enum AutoFillFieldStatus {
  FILLED
  NEEDS_REVIEW
  MISSING
  AMBIGUOUS
  SIGNATURE
  MANUAL
}

enum AutoFillConfidence {
  HIGH
  MEDIUM
  LOW
}

model AutoFillJob {
  id               String            @id @default(cuid())
  studentProfileId String
  status           AutoFillJobStatus @default(DRAFT)

  sourceFileName   String
  sourceStorageKey String @unique
  sourceSizeBytes  Int
  sourcePageCount  Int?

  /// Why the completed form could not be read, in words shown to the student.
  failureReason String?
  /// Which matcher produced this mapping, so a result can be reproduced.
  matcher       String?

  createdAt   DateTime  @default(now())
  startedAt   DateTime?
  completedAt DateTime?

  studentProfile  StudentProfile           @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  targetForms     AutoFillTargetForm[]
  extractedValues AutoFillExtractedValue[]

  @@index([studentProfileId, createdAt])
}

/// One piece of information read out of the completed form.
model AutoFillExtractedValue {
  id           String             @id @default(cuid())
  jobId        String
  canonicalKey String
  kind         String
  /// Normalised form, e.g. an ISO date.
  value        String
  /// What the source literally said, kept for display and audit.
  raw          String
  confidence   AutoFillConfidence

  sourcePage       Int?
  sourceFieldLabel String
  /// "acroform" when read from a real field, "text-layout" when inferred.
  method           String

  job AutoFillJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, canonicalKey])
  @@index([jobId])
}

model AutoFillTargetForm {
  id                 String             @id @default(cuid())
  jobId              String
  status             AutoFillFormStatus @default(PENDING)
  originalFileName   String
  originalStorageKey String             @unique
  sizeBytes          Int
  pageCount          Int?

  /// Set when this form alone could not be processed.
  failureReason String?

  fieldsTotal       Int @default(0)
  fieldsFilled      Int @default(0)
  /// Populated, but the student is asked to confirm it. Counted separately
  /// because "no field is confirmed" and "no field has an answer" are very
  /// different things to tell someone looking at a filled-in page.
  fieldsToConfirm   Int @default(0)
  fieldsOutstanding Int @default(0)

  processedAt DateTime?

  job    AutoFillJob     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  fields AutoFillField[]

  @@index([jobId])
}

model AutoFillField {
  id           String              @id @default(cuid())
  targetFormId String
  /// The PDF field name, or a synthetic id for a label found in the text layer.
  fieldName    String
  label        String
  kind         String
  page         Int
  status       AutoFillFieldStatus
  /// Null whenever nothing is written. Never a guess.
  value        String?
  canonicalKey String?
  confidence   AutoFillConfidence?
  /// Why this outcome was reached, in words the student can read.
  reason       String
  options      String[]

  /// Where the value came from, so a populated field can be traced back.
  sourceDocumentName String?
  sourcePage         Int?
  sourceFieldLabel   String?

  /// Widget rectangle, used to highlight the field on the page preview.
  rectX      Float?
  rectY      Float?
  rectWidth  Float?
  rectHeight Float?

  /// True once the student has changed this value themselves.
  editedByStudent Boolean @default(false)

  targetForm AutoFillTargetForm  @relation(fields: [targetFormId], references: [id], onDelete: Cascade)
  edits      AutoFillFieldEdit[]

  @@unique([targetFormId, fieldName])
  @@index([targetFormId])
}

/// Every change a student makes to a populated field, kept so a submitted
/// form can always be explained.
model AutoFillFieldEdit {
  id            String   @id @default(cuid())
  fieldId       String
  previousValue String?
  newValue      String?
  editedAt      DateTime @default(now())

  field AutoFillField @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@index([fieldId, editedAt])
}

// ---------------------------------------------------------------------------
// Opportunity provenance and ingestion
//
// Every opportunity shown to a student must be traceable to a real source. The
// models below record where each one came from, when it was last confirmed,
// where its sources disagree, and what each ingestion run actually did.
//
// Nothing here manufactures an opportunity. An opportunity with no source is
// not an opportunity; it is a defect, and validation refuses it.
// ---------------------------------------------------------------------------

enum OpportunityOrigin {
  /// Published here by the funding organisation itself. Bursary-Bridge is the
  /// official source for these.
  FIRST_PARTY
  /// Discovered on a public source and recorded with that source's provenance.
  EXTERNAL
}

enum OrganisationOrigin {
  REGISTERED
  EXTERNAL
}

/// The source hierarchy. Lower is more authoritative, and the ingestion
/// pipeline prefers the lowest available when sources disagree.
enum SourceType {
  /// Level 1: the organisation offering the bursary.
  OFFICIAL_ORGANISATION
  /// Level 2: a university, government department or other official institution.
  OFFICIAL_INSTITUTION
  /// Level 3: a reputable publication that links back to the original.
  SECONDARY_PUBLICATION
  /// Level 4: anything else, used only where credibility has been established.
  OTHER
}

/// Whether a student can apply right now. Derived from the source's own words
/// first and from dates only as a fallback — never guessed.
enum Availability {
  OPEN
  /// Open, with the deadline close enough that a student should act now.
  CLOSING_SOON
  UPCOMING
  CLOSED
  UNKNOWN
}

enum VerificationStatus {
  /// Confirmed against its source inside the freshness window.
  VERIFIED
  /// Recorded but not yet checked against its source.
  UNVERIFIED
  /// The last successful check is too old to rely on.
  STALE
  /// Sources disagree and no official source settles it.
  CONFLICTED
  /// The source no longer carries this opportunity.
  SOURCE_GONE
}

enum DeadlineKind {
  FIXED
  ROLLING
  UNTIL_FILLED
  UNKNOWN
}

/// One source that carries this opportunity. An opportunity may appear on
/// several sites; all of them are kept, and the most authoritative is primary.
model OpportunitySource {
  id                 String     @id @default(cuid())
  fundingProgrammeId String
  url                String
  name               String
  type               SourceType
  /// True when this is the funder's own website.
  official           Boolean    @default(false)
  isPrimary          Boolean    @default(false)

  /// Hash of the extracted content, so an unchanged page is recognised
  /// without re-parsing it.
  contentHash String?

  firstSeenAt    DateTime  @default(now())
  lastCheckedAt  DateTime?
  lastVerifiedAt DateTime?

  fundingProgramme FundingProgramme @relation(fields: [fundingProgrammeId], references: [id], onDelete: Cascade)

  @@unique([fundingProgrammeId, url])
  @@index([fundingProgrammeId])
}

/// Two sources state different things. Recorded rather than silently resolved,
/// so a wrong deadline can always be traced back.
model SourceConflict {
  id                 String    @id @default(cuid())
  fundingProgrammeId String
  /// The field they disagree about, e.g. "closingDate".
  field              String
  officialValue      String?
  officialSourceUrl  String?
  otherValue         String
  otherSourceUrl     String
  /// What was used, and why.
  resolution         String
  resolvedAt         DateTime?
  createdAt          DateTime  @default(now())

  fundingProgramme FundingProgramme @relation(fields: [fundingProgrammeId], references: [id], onDelete: Cascade)

  @@index([fundingProgrammeId])
}

/// An official application form published by the funder.
///
/// A form is only stored when its source permits it. `storageKey` is null for
/// a form that is linked but not mirrored, and the student is sent to the
/// source instead.
model ApplicationForm {
  id                 String  @id @default(cuid())
  fundingProgrammeId String
  name               String
  /// The page the form was found on.
  sourceUrl          String
  /// The file's own address on the source.
  fileUrl            String
  fileType           String
  sizeBytes          Int?
  /// Set only when the file was mirrored. Null means link-only.
  storageKey         String? @unique
  /// SHA-256 of the mirrored file, so a silent change is detectable.
  fileHash           String?
  official           Boolean @default(true)
  /// Names the funder, so the student cannot mistake it for a Bursary-Bridge form.
  providedBy         String

  lastVerifiedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  fundingProgramme FundingProgramme @relation(fields: [fundingProgrammeId], references: [id], onDelete: Cascade)

  @@index([fundingProgrammeId])
}

enum IngestionRunStatus {
  RUNNING
  SUCCEEDED
  FAILED
  /// Could not run: no network egress, or every source refused by robots.txt.
  BLOCKED
}

/// What one pass of the ingestion pipeline actually did. Surfaced in the admin
/// portal so nobody has to guess whether the data is fresh.
model IngestionRun {
  id      String             @id @default(cuid())
  status  IngestionRunStatus @default(RUNNING)
  /// "scheduled", "manual" or "import".
  trigger String

  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  sourcesAttempted Int @default(0)
  sourcesSucceeded Int @default(0)
  /// Refused by the source's own robots.txt, and therefore not fetched.
  sourcesBlocked   Int @default(0)
  sourcesFailed    Int @default(0)

  opportunitiesFound   Int @default(0)
  opportunitiesCreated Int @default(0)
  opportunitiesUpdated Int @default(0)
  duplicatesMerged     Int @default(0)
  /// Failed validation and were not written. A rejected record is a record
  /// that would have been invented.
  rejected             Int @default(0)

  notes String?

  events IngestionEvent[]

  @@index([startedAt])
}

enum IngestionEventLevel {
  INFO
  WARN
  ERROR
}

model IngestionEvent {
  id         String              @id @default(cuid())
  runId      String
  level      IngestionEventLevel @default(INFO)
  sourceName String?
  sourceUrl  String?
  message    String
  createdAt  DateTime            @default(now())

  run IngestionRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, createdAt])
}

// ---------------------------------------------------------------------------
// Catalogue, results, letters and information requests
//
// One canonical catalogue of institutions and courses underpins study
// preferences, funder eligibility and matching, so a course chosen by a
// student and a course named by a funder are the same row rather than two
// spellings that never meet.
// ---------------------------------------------------------------------------

enum CatalogueStatus {
  ACTIVE
  /// Kept for the records that reference it, but no longer offered for new
  /// choices. Catalogue entries are never deleted.
  INACTIVE
}

/// Where a course is actually offered.
///
/// A course and an institution are not independent lists: "Computer Science"
/// means something different at each university that teaches it, and a student
/// choosing a pair that nobody offers is choosing something that does not
/// exist.
model ProgrammeInstitution {
  programmeId   String
  institutionId String
  /// This institution's own code for the course, where it differs.
  code          String?
  createdAt     DateTime @default(now())

  programme   Programme   @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@id([programmeId, institutionId])
  @@index([institutionId])
}

// --- Subject and module results --------------------------------------------

enum SubjectLevel {
  /// A school subject, taken towards the National Senior Certificate.
  SCHOOL
  /// A module or course taken at a university, university of technology,
  /// TVET college or other tertiary institution.
  TERTIARY
}

enum ResultKind {
  /// The mark as it stands now.
  CURRENT
  /// The final, confirmed mark.
  FINAL
  /// A mark the institution or teacher expects.
  PREDICTED
  /// The most recent mark available, where its kind is not stated.
  LATEST
}

/// The shared list of subjects and modules.
///
/// Students pick from this where they can, so "Mathematics", "mathematics" and
/// "Maths" do not become three different subjects that a bursary requirement
/// can only match one of. A student may still type something not on the list;
/// it is stored, marked custom, and never silently merged with an existing row.
model SubjectCatalogue {
  id            String          @id @default(cuid())
  name          String
  canonicalName String          @unique
  level         SubjectLevel
  status        CatalogueStatus @default(ACTIVE)
  /// True when a student typed it rather than choosing it. Kept visible so an
  /// administrator can promote it into the catalogue or merge it deliberately.
  custom        Boolean         @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  results      StudentSubjectResult[]
  requirements EligibilitySubjectRequirement[]

  @@index([level, status])
}

/// One subject or module result a student has entered.
model StudentSubjectResult {
  id               String @id @default(cuid())
  studentProfileId String
  subjectId        String

  /// The mark as a percentage. Null when the student knows the subject but not
  /// yet the mark — which is a real state, and not the same as a zero.
  percentage Int?
  /// The symbol or grade, where that is how the result was given.
  grade      String?
  year       Int
  /// "Semester 1", "Term 3" — free text, because institutions differ.
  term       String?
  kind       ResultKind   @default(LATEST)
  level      SubjectLevel

  /// The student's own ordering.
  position Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  studentProfile StudentProfile   @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  subject        SubjectCatalogue @relation(fields: [subjectId], references: [id], onDelete: Restrict)

  /// One result per subject per year: a re-sit replaces the mark rather than
  /// adding a second row that matching would have to choose between.
  @@unique([studentProfileId, subjectId, year])
  @@index([studentProfileId, position])
}

/// A subject mark a funder requires, e.g. Mathematics at 70% or above.
model EligibilitySubjectRequirement {
  id                String @id @default(cuid())
  eligibilityRuleId String
  subjectId         String
  minimumPercentage Int

  createdAt DateTime @default(now())

  eligibilityRule EligibilityRule  @relation(fields: [eligibilityRuleId], references: [id], onDelete: Cascade)
  subject         SubjectCatalogue @relation(fields: [subjectId], references: [id], onDelete: Restrict)

  @@unique([eligibilityRuleId, subjectId])
  @@index([subjectId])
}

// --- Motivational letters ---------------------------------------------------

enum LetterStatus {
  DRAFT
  /// The student has marked it finished. It stays editable.
  READY
}

/// A motivational letter written for one opportunity.
///
/// Letters are kept individually and never overwritten: a student applying to
/// six bursaries needs six letters, and losing one to a regenerate would lose
/// work they cannot get back.
model MotivationalLetter {
  id                 String  @id @default(cuid())
  studentProfileId   String
  fundingProgrammeId String?
  /// Kept verbatim so the letter still names its bursary if the opportunity is
  /// later removed from the catalogue.
  opportunityName    String
  organisationName   String

  title   String
  content String
  status  LetterStatus @default(DRAFT)

  /// The student's own answers, kept so a regenerate does not ask again and so
  /// the letter can be traced to what they actually said.
  answers Json?

  /// Which generator produced the current text, so a letter can be reproduced.
  generator String?

  /// True once the student has edited the text themselves.
  editedByStudent Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  studentProfile   StudentProfile    @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  fundingProgramme FundingProgramme? @relation(fields: [fundingProgrammeId], references: [id], onDelete: SetNull)

  @@index([studentProfileId, updatedAt])
}

// --- Information requests ---------------------------------------------------

enum InformationRequestStatus {
  /// Sent to the student, nothing supplied yet.
  OPEN
  /// The student has submitted their response.
  RESPONDED
  /// Withdrawn by the funder before it was answered.
  CANCELLED
}

/// A funder asking an applicant for something specific.
///
/// Stored rather than being a message, so both sides can see exactly what was
/// asked for, what has been supplied and what is still outstanding.
model InformationRequest {
  id             String @id @default(cuid())
  applicationId  String
  organisationId String
  /// The corporate user who sent it.
  requestedById  String

  message  String?
  deadline DateTime?
  status   InformationRequestStatus @default(OPEN)

  createdAt   DateTime  @default(now())
  respondedAt DateTime?
  cancelledAt DateTime?

  application  Application              @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  organisation Organisation             @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  requestedBy  User                     @relation("InformationRequester", fields: [requestedById], references: [id], onDelete: Cascade)
  items        InformationRequestItem[]

  @@index([applicationId, createdAt])
  @@index([organisationId, status])
}

/// One thing the funder asked for.
model InformationRequestItem {
  id        String @id @default(cuid())
  requestId String

  /// The funder's own words. Preserved exactly: a funder who asks for "a
  /// certified copy of your latest university academic record" must not have
  /// it flattened into "Academic record".
  label        String
  /// Set when the request maps onto a document type the student already has a
  /// slot for, so an existing upload can be offered.
  documentType DocumentType?

  /// The document the student supplied for this item.
  documentId String?

  createdAt   DateTime  @default(now())
  fulfilledAt DateTime?

  request  InformationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  document Document?          @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([requestId])
  @@index([documentId])
}
