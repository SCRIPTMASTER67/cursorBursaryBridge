  HEALTHCARE
  FINANCE_ACCOUNTING
  LAW
  EDUCATION
  AGRICULTURE
  SCIENCE_RESEARCH
  BUSINESS
  GOVERNMENT
  MINING
  ENERGY
  MANUFACTURING
  CONSTRUCTION
  MEDIA_COMMUNICATIONS
  OTHER
}

enum Province {
  EASTERN_CAPE
  FREE_STATE
  GAUTENG
  KWAZULU_NATAL
  LIMPOPO
  MPUMALANGA
  NORTHERN_CAPE
  NORTH_WEST
  WESTERN_CAPE
}

enum InstitutionType {
  UNIVERSITY
  UNIVERSITY_OF_TECHNOLOGY
  TVET_COLLEGE
  PRIVATE_INSTITUTION
  OTHER
