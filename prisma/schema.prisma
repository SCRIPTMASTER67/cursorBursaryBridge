// ---------------------------------------------------------------------------
// Bursary-Bridge — PostgreSQL schema
//
// Two visible roles: STUDENT and CORPORATE.
// Service boundaries are kept clean so that verification, messaging and
// reporting subsystems can be layered on later without a rewrite.
// ---------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===========================================================================
// Enums
// ===========================================================================

enum UserRole {
  STUDENT
  CORPORATE
  ADMIN
}

/// Account state. Suspension is reversible and is the only account-level
/// control an administrator has; accounts are never deleted from the portal.
enum AccountStatus {
  ACTIVE
  SUSPENDED
}

enum EducationStage {
  GRADE_10
  GRADE_11
  MATRIC
  UNIVERSITY_FIRST_YEAR
  UNIVERSITY_CURRENT
  TVET_COLLEGE
  POSTGRADUATE
  PLANNING_TO_STUDY
  OTHER
}

enum QualificationLevel {
  CERTIFICATE
  DIPLOMA
  ADVANCED_DIPLOMA
  BACHELORS
  HONOURS
  MASTERS
  DOCTORAL
  OTHER
}

enum StudyStatus {
  CURRENTLY_ENROLLED
  ACCEPTED_NOT_REGISTERED
  APPLIED_AWAITING
  PLANNING_TO_APPLY
  RETURNING_STUDENT
  OTHER
}

enum ResultType {
  SCHOOL_REPORT
  MATRIC_RESULTS
  UNIVERSITY_TRANSCRIPT
  ACADEMIC_RECORD
  OTHER
  NONE_YET
}

enum Achievement {
  SUBJECT_DISTINCTIONS
  ACADEMIC_AWARDS
  DEANS_LIST
  COMPETITIONS
  OLYMPIADS
  RESEARCH
  OTHER
  NONE
}

enum FundingNeed {
  TUITION_FEES
  REGISTRATION_FEES
  ACCOMMODATION
  BOOKS_MATERIALS
  MEALS_LIVING
  TRANSPORT
  LAPTOP_DEVICE
  OTHER_EXPENSES
  FULL_FUNDING
  PARTIAL_FUNDING
  NOT_SURE
}

enum FundingSituation {
  NO_FUNDING
  PARTIALLY_FUNDED
  FULLY_FUNDED
  AWAITING_DECISION
  DONT_KNOW
}

enum BursaryStatus {
  YES
  NO
  APPLICATION_PENDING
  PREFER_NOT_TO_SAY
}

enum IncomeBand {
  BELOW_50K
  R50K_100K
  R100K_200K
  R200K_350K
  R350K_500K
  ABOVE_500K
  DONT_KNOW
  PREFER_NOT_TO_SAY
