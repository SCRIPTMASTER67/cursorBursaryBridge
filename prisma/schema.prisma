  TALENT_MANAGER
  CSI_MANAGER
  FOUNDATION_MANAGER
  PROGRAMME_MANAGER
  ADMINISTRATOR
  EXECUTIVE
  OTHER
}

enum OrganisationSize {
  UNDER_50
  SIZE_50_250
  SIZE_251_1000
  SIZE_1001_5000
  ABOVE_5000
}

enum ProgrammeTypeOffered {
  BURSARIES
  SCHOLARSHIPS
  GRANTS
  INTERNSHIPS
  LEARNERSHIPS
  GRADUATE_PROGRAMMES
  OTHER
