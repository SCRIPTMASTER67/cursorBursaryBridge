enum ApplicationVolume {
  UNDER_100
  V100_500
  V501_1000
  V1001_5000
  V5001_10000
  ABOVE_10000
}

enum ProcessMethod {
  EMAIL
  SPREADSHEETS
  GOOGLE_FORMS
  WEBSITE_FORMS
  DEDICATED_SOFTWARE
  MANUAL_PROCESS
  OTHER
}

enum ProcessChallenge {
  TOO_MANY_APPLICATIONS
  MANUAL_SCREENING
