  FINDING_ELIGIBLE_APPLICANTS
  COMMUNICATION
  SHORTLISTING
  REPORTING
  FRAUD_DUPLICATES
  TRACKING_BENEFICIARIES
  OTHER
}

enum FundingType {
  BURSARY
  SCHOLARSHIP
  GRANT
  OTHER
}

enum FundingCoverage {
  TUITION_FEES
  REGISTRATION_FEES
  ACCOMMODATION
  MEALS_LIVING
  BOOKS_MATERIALS
  LAPTOP_DEVICE
  TRANSPORT
  OTHER
}

enum ProgrammeStatus {
  DRAFT
  PUBLISHED
  CLOSED
  /// Withdrawn by an administrator for a policy breach. Only an administrator
  /// can clear it, so the owning organisation cannot simply publish again.
  SUSPENDED
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  DOCUMENTS_REQUIRED
  SHORTLISTED
  APPROVED
  UNSUCCESSFUL
}

enum MatchClassification {
  STRONG_MATCH
  POTENTIAL_MATCH
  MORE_INFO_NEEDED
}

/// The funder-facing verdict, recorded when an application is submitted.
/// Missing information is PENDING_VERIFICATION, never an automatic rejection.
enum EligibilityOutcome {
  ELIGIBLE
  NOT_ELIGIBLE
  PENDING_VERIFICATION
}

enum DocumentType {
  ID_DOCUMENT
  ACADEMIC_RECORD
  TRANSCRIPT
  MATRIC_CERTIFICATE
  PROOF_OF_RESIDENCE
  PROOF_OF_INCOME
  PROOF_OF_REGISTRATION
  CV
  MOTIVATION_LETTER
  OTHER
}

enum ShortlistStatus {
  SHORTLISTED
  SELECTED
  WITHDRAWN
}

enum NotificationType {
  NEW_MATCH
  APPLICATION_SUBMITTED
  APPLICATION_STATUS_CHANGED
  DEADLINE_APPROACHING
  INFORMATION_REQUESTED
  PROGRAMME_PUBLISHED
  WELCOME
}

enum QuestionType {
  SHORT_TEXT
  LONG_TEXT
  SINGLE_SELECT
  MULTI_SELECT
  NUMBER
  DATE
  YES_NO
}

// ===========================================================================
// Identity & access
// ===========================================================================

model User {
  id                 String        @id @default(cuid())
  email              String        @unique
  passwordHash       String
  role               UserRole
  status             AccountStatus @default(ACTIVE)
  mustResetPassword  Boolean       @default(false)
  firstName          String
  lastName           String
  mobile             String?
  emailVerifiedAt    DateTime?
  emailNotifications Boolean       @default(true)
  acceptedTermsAt    DateTime?
  lastLoginAt        DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  sessions           Session[]
  verificationToken  VerificationToken?
  passwordResetToken PasswordResetToken?
  studentProfile     StudentProfile?
  corporateProfile   CorporateProfile?
  notifications      Notification[]
  auditLogs          AuditLog[]
  createdProgrammes  FundingProgramme[]  @relation("ProgrammeCreator")
  shortlistEntries   Shortlist[]         @relation("ShortlistAddedBy")

  @@index([role])
  @@index([status])
}

/// Opaque, revocable server-side sessions. Only the SHA-256 hash of the
/// session token is stored, so a database leak cannot be replayed as a login.
model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  userAgent String?
  ipAddress String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// Single-use password reset tokens.
///
/// Separate from VerificationToken because that model is unique on userId and
/// already carries email verification; one table could not hold both for the
/// same account. Only the hash is stored, so the database cannot be read to
/// forge a reset link. Unique on userId, so issuing a new link invalidates any
/// previous one.
model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String   @unique
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  id        String   @id @default(cuid())
  userId    String   @unique
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ===========================================================================
// Reference catalogue (standardised institutions & programmes)
// ===========================================================================

model Institution {
  id        String          @id @default(cuid())
  name      String          @unique
  shortName String?
  type      InstitutionType
  province  Province
  city      String
  createdAt DateTime        @default(now())

  studyPreferences   StudyPreference[]
  currentStudents    StudentProfile[]              @relation("CurrentInstitution")
  supportedInProgram FundingProgrammeInstitution[]

  @@index([province])
  @@index([type])
}

/// A standardised course / programme of study (e.g. "Computer Science").
model Programme {
  id                  String               @id @default(cuid())
  name                String               @unique
  field               CareerInterest
  qualificationLevels QualificationLevel[]
  createdAt           DateTime             @default(now())

  studyPreferences   StudyPreference[]
  currentStudents    StudentProfile[]            @relation("CurrentProgramme")
  supportedInProgram FundingProgrammeProgramme[]

  @@index([field])
}

// ===========================================================================
// Student
// ===========================================================================

model StudentProfile {
  id     String @id @default(cuid())
  userId String @unique

  // Education journey
  educationStage       EducationStage?
  qualificationLevel   QualificationLevel?
  studyStatus          StudyStatus?
  currentInstitutionId String?
  currentProgrammeId   String?
  yearOfStudy          Int?

  // Academic profile
  academicAverage        Int?
  academicAverageUnknown Boolean       @default(false)
  resultTypes            ResultType[]
  achievements           Achievement[]

  // Funding needs
  fundingNeeds     FundingNeed[]
  fundingSituation FundingSituation?
  bursaryStatus    BursaryStatus?

  // Financial profile
  householdIncome IncomeBand?

  // Personal eligibility
  dateOfBirth      DateTime?
  citizenship      Citizenship?
  firstGeneration  TriState?
  disability       TriState?
  orphanVulnerable TriState?

  // Location
  province                Province?
  city                    String?
  studyLocationPreference StudyLocationPreference?

  // Interests
  careerInterests CareerInterest[]

  // Onboarding / progressive completion
  onboardingStep        String    @default("education")
  onboardingCompletedAt DateTime?
  profileStrength       Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentInstitution Institution?      @relation("CurrentInstitution", fields: [currentInstitutionId], references: [id], onDelete: SetNull)
  currentProgramme   Programme?        @relation("CurrentProgramme", fields: [currentProgrammeId], references: [id], onDelete: SetNull)
  studyPreferences   StudyPreference[]
  applications       Application[]
  documents          Document[]
  autoFillJobs       AutoFillJob[]

  @@index([province])
  @@index([educationStage])
}

/// A course paired with the institution the student wants to study it at.
/// A student may hold a maximum of six (enforced in the service layer and by
/// the unique constraint on preferenceNumber).
model StudyPreference {
  id               String @id @default(cuid())
  studentProfileId String
  preferenceNumber Int
  programmeId      String
  institutionId    String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  programme      Programme      @relation(fields: [programmeId], references: [id], onDelete: Restrict)
  institution    Institution    @relation(fields: [institutionId], references: [id], onDelete: Restrict)

  @@unique([studentProfileId, preferenceNumber])
  @@unique([studentProfileId, programmeId, institutionId])
  @@index([programmeId])
  @@index([institutionId])
}

// ===========================================================================
// Corporate / funder
// ===========================================================================

model Organisation {
  id          String           @id @default(cuid())
  name        String           @unique
  status      AccountStatus    @default(ACTIVE)
  type        OrganisationType
  industry    Industry
  website     String?
  country     String           @default("South Africa")
  description String?
  logoUrl     String?

  // Funding profile
  offersFunding     OffersFunding?
  programmeTypes    ProgrammeTypeOffered[]
  applicationVolume ApplicationVolume?

  // Current process
  processMethods ProcessMethod[]
  challenges     ProcessChallenge[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members      CorporateProfile[]
  programmes   FundingProgramme[]
  applications Application[]
  shortlists   Shortlist[]
}

model CorporateProfile {
  id               String            @id @default(cuid())
  userId           String            @unique
  organisationId   String
  role             CorporateRole?
  department       String?
  organisationSize OrganisationSize?

  onboardingStep        String    @default("organisation")
  onboardingCompletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@index([organisationId])
}

// ===========================================================================
// Funding programmes & eligibility
// ===========================================================================

model FundingProgramme {
  id               String            @id @default(cuid())
  organisationId   String
  createdById      String?
  name             String
  slug             String            @unique
  shortDescription String
  fullDescription  String
  fundingType      FundingType
  coverage         FundingCoverage[]
  openDate         DateTime
  closingDate      DateTime
  status           ProgrammeStatus   @default(DRAFT)
  intakeTarget     Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation("ProgrammeCreator", fields: [createdById], references: [id], onDelete: SetNull)

  eligibility           EligibilityRule?
  supportedInstitutions FundingProgrammeInstitution[]
  supportedProgrammes   FundingProgrammeProgramme[]
  questions             ApplicationQuestion[]
  applications          Application[]
  shortlists            Shortlist[]

  @@index([organisationId])
  @@index([status])
  @@index([closingDate])
}

/// The machine-readable rule set the eligibility & matching services evaluate.
model EligibilityRule {
  id                 String @id @default(cuid())
  fundingProgrammeId String @unique

  minAcademicAverage    Int?
  qualificationLevels   QualificationLevel[]
  yearsOfStudy          Int[]
  citizenship           Citizenship[]
  maxHouseholdIncome    IncomeBand?
  requiresFinancialNeed Boolean              @default(false)
  provinces             Province[]
  otherRequirements     String?
  requiredDocuments     DocumentType[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fundingProgramme FundingProgramme @relation(fields: [fundingProgrammeId], references: [id], onDelete: Cascade)
}

model FundingProgrammeInstitution {
  fundingProgrammeId String
  institutionId      String

  fundingProgramme FundingProgramme @relation(fields: [fundingProgrammeId], references: [id], onDelete: Cascade)
  institution      Institution      @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@id([fundingProgrammeId, institutionId])
  @@index([institutionId])
}

model FundingProgrammeProgramme {
  fundingProgrammeId String
  programmeId        String

  fundingProgramme FundingProgramme @relation(fields: [fundingProgrammeId], references: [id], onDelete: Cascade)
  programme        Programme        @relation(fields: [programmeId], references: [id], onDelete: Cascade)

  @@id([fundingProgrammeId, programmeId])
  @@index([programmeId])
}

/// Programme-specific questions asked at application time only — never during
/// student registration.
model ApplicationQuestion {
  id                 String       @id @default(cuid())
  fundingProgrammeId String
  label              String
  helpText           String?
  type               QuestionType
  required           Boolean      @default(false)
  options            String[]
  order              Int

  fundingProgramme FundingProgramme @relation(fields: [fundingProgrammeId], references: [id], onDelete: Cascade)

  @@index([fundingProgrammeId])
}

// ===========================================================================
// Applications
// ===========================================================================

model Application {
  id                 String            @id @default(cuid())
  studentProfileId   String
  fundingProgrammeId String
  organisationId     String
  status             ApplicationStatus @default(DRAFT)

  // Snapshot of the match at submission time, so the score shown to the funder
  // is stable even if the student later edits their profile.
  matchScore          Int?
  matchClassification MatchClassification?
  matchReasons        Json?
  eligibilityOutcome  EligibilityOutcome?

  answers            Json?
  reviewNotes        String?
  submittedAt        DateTime?
  lastStatusChangeAt DateTime?
  decisionAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  studentProfile   StudentProfile        @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  fundingProgramme FundingProgramme      @relation(fields: [fundingProgrammeId], references: [id], onDelete: Cascade)
  organisation     Organisation          @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  documents        ApplicationDocument[]
  shortlist        Shortlist?

  @@unique([studentProfileId, fundingProgrammeId])
  @@index([fundingProgrammeId, status])
  @@index([organisationId, status])
  @@index([studentProfileId])
  @@index([matchScore])
  @@index([organisationId, eligibilityOutcome])
}

model Document {
  id               String       @id @default(cuid())
  studentProfileId String
  type             DocumentType
  fileName         String
  mimeType         String
  sizeBytes        Int
  storageKey       String       @unique
  uploadedAt       DateTime     @default(now())

  studentProfile StudentProfile        @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  applications   ApplicationDocument[]

  @@index([studentProfileId])
}

model ApplicationDocument {
  applicationId String
  documentId    String
  requirement   DocumentType

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  document    Document    @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@id([applicationId, documentId])
  @@index([documentId])
}

model Shortlist {
  id                 String          @id @default(cuid())
  organisationId     String
  fundingProgrammeId String
  applicationId      String          @unique
  addedById          String?
  status             ShortlistStatus @default(SHORTLISTED)
  note               String?
  addedAt            DateTime        @default(now())
  selectedAt         DateTime?

  organisation     Organisation     @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  fundingProgramme FundingProgramme @relation(fields: [fundingProgrammeId], references: [id], onDelete: Cascade)
  application      Application      @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  addedBy          User?            @relation("ShortlistAddedBy", fields: [addedById], references: [id], onDelete: SetNull)

  @@index([organisationId, status])
  @@index([fundingProgrammeId])
}

// ===========================================================================
// Notifications & audit
// ===========================================================================

model Notification {
  id          String           @id @default(cuid())
  userId      String
  type        NotificationType
  title       String
  body        String
  link        String?
  readAt      DateTime?
  emailSentAt DateTime?
  createdAt   DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([action, createdAt])
}

// ---------------------------------------------------------------------------
// Form auto-filling
//
// A student uploads one completed bursary form and any number of blank ones.
// The completed form is read into canonical values; each blank form is mapped
// against them field by field. Every decision is stored with the reason behind
// it, because the student is asked to check the result before submitting it
// and cannot check what they cannot see.
//
// Filled PDFs are not stored. They are produced from the original upload and
// the current field values whenever one is downloaded, so an edited value can
// never disagree with the file the student sends to a funder.
// ---------------------------------------------------------------------------

enum AutoFillJobStatus {
  DRAFT
  PROCESSING
  COMPLETED
  /// The completed form could not be read, so no target could be attempted.
  FAILED
}

enum AutoFillFormStatus {
  PENDING
  PROCESSING
  COMPLETED
  /// This form alone failed. The rest of the batch is unaffected.
  FAILED
}

/// The outcome of one field on one target form. Mirrors MappingStatus in
/// lib/pdf/map.ts; only FILLED and NEEDS_REVIEW carry a value.
enum AutoFillFieldStatus {
  FILLED
  NEEDS_REVIEW
  MISSING
  AMBIGUOUS
  SIGNATURE
  MANUAL
}

enum AutoFillConfidence {
  HIGH
  MEDIUM
  LOW
}

model AutoFillJob {
  id               String            @id @default(cuid())
  studentProfileId String
  status           AutoFillJobStatus @default(DRAFT)

  sourceFileName   String
  sourceStorageKey String @unique
  sourceSizeBytes  Int
  sourcePageCount  Int?

  /// Why the completed form could not be read, in words shown to the student.
  failureReason String?
  /// Which matcher produced this mapping, so a result can be reproduced.
  matcher       String?

  createdAt   DateTime  @default(now())
  startedAt   DateTime?
  completedAt DateTime?

  studentProfile  StudentProfile           @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  targetForms     AutoFillTargetForm[]
  extractedValues AutoFillExtractedValue[]

  @@index([studentProfileId, createdAt])
}

/// One piece of information read out of the completed form.
model AutoFillExtractedValue {
  id           String             @id @default(cuid())
  jobId        String
  canonicalKey String
  kind         String
  /// Normalised form, e.g. an ISO date.
  value        String
  /// What the source literally said, kept for display and audit.
  raw          String
  confidence   AutoFillConfidence

  sourcePage       Int?
  sourceFieldLabel String
  /// "acroform" when read from a real field, "text-layout" when inferred.
  method           String

  job AutoFillJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, canonicalKey])
  @@index([jobId])
}

model AutoFillTargetForm {
  id                 String             @id @default(cuid())
  jobId              String
  status             AutoFillFormStatus @default(PENDING)
  originalFileName   String
  originalStorageKey String             @unique
  sizeBytes          Int
  pageCount          Int?

  /// Set when this form alone could not be processed.
  failureReason String?

  fieldsTotal       Int @default(0)
  fieldsFilled      Int @default(0)
  fieldsOutstanding Int @default(0)

  processedAt DateTime?

  job    AutoFillJob     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  fields AutoFillField[]

  @@index([jobId])
}

model AutoFillField {
  id           String              @id @default(cuid())
  targetFormId String
  /// The PDF field name, or a synthetic id for a label found in the text layer.
  fieldName    String
  label        String
  kind         String
  page         Int
  status       AutoFillFieldStatus
  /// Null whenever nothing is written. Never a guess.
  value        String?
  canonicalKey String?
  confidence   AutoFillConfidence?
  /// Why this outcome was reached, in words the student can read.
  reason       String
  options      String[]

  /// Where the value came from, so a populated field can be traced back.
  sourceDocumentName String?
  sourcePage         Int?
  sourceFieldLabel   String?

  /// Widget rectangle, used to highlight the field on the page preview.
  rectX      Float?
  rectY      Float?
  rectWidth  Float?
  rectHeight Float?

  /// True once the student has changed this value themselves.
  editedByStudent Boolean @default(false)

  targetForm AutoFillTargetForm  @relation(fields: [targetFormId], references: [id], onDelete: Cascade)
  edits      AutoFillFieldEdit[]

  @@unique([targetFormId, fieldName])
  @@index([targetFormId])
}

/// Every change a student makes to a populated field, kept so a submitted
/// form can always be explained.
model AutoFillFieldEdit {
  id            String   @id @default(cuid())
  fieldId       String
  previousValue String?
  newValue      String?
  editedAt      DateTime @default(now())

  field AutoFillField @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@index([fieldId, editedAt])
}
