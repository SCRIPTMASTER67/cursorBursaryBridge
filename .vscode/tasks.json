{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Set up: install, migrate, seed",
      "type": "shell",
      "command": "npm install && npm run db:deploy && npm run db:seed",
      "problemMatcher": [],
      "group": "build"
    },
    {
      "label": "Run dev server",
      "type": "shell",
      "command": "npm run dev",
      "isBackground": true,
      "problemMatcher": {
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Starting",
          "endsPattern": "Ready in"
        }
      },
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "Prisma Studio",
      "type": "shell",
      "command": "npm run db:studio",
      "problemMatcher": []
    },
    {
      "label": "Reseed database",
      "type": "shell",
      "command": "npm run db:seed",
      "problemMatcher": []
    },
    {
      "label": "Typecheck",
      "type": "shell",
      "command": "npm run typecheck",
      "problemMatcher": ["$tsc"],
      "group": "test"
    },
    {
      "label": "Run tests",
      "type": "shell",
      "command": "npm test",
      "problemMatcher": [],
      "group": { "kind": "test", "isDefault": true }
    }
  ]
}
